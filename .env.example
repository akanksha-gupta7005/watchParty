# Copy to .env to change any of these. All of them are optional.

# Web app is served at http://localhost:${WEB_PORT}
WEB_PORT=3000

# PostgreSQL
POSTGRES_DB=watchparty
POSTGRES_USER=watchparty
POSTGRES_PASSWORD=watchparty
# Host port for the database (change if you already run Postgres locally on 5432)
DB_PORT=5432

# Backend
# Browser origins allowed to call the API / open the WebSocket. "*" is fine locally;
# in production set your real site, e.g. https://watchparty.example.com
ALLOWED_ORIGINS=*
# Seconds a disconnected user keeps their seat and role (page refresh, network blip)
RECONNECT_GRACE_SECONDS=30
# Secret that signs login tokens. Use a long random value (40+ characters) and keep it private.
AUTH_SECRET=change-me-to-a-long-random-value-0123456789
# Maximum people in one room
MAX_PARTICIPANTS_PER_ROOM=100
# Database connection pool size
DB_POOL_SIZE=10
# Rooms untouched for this many days are deleted
ROOM_RETENTION_DAYS=7
